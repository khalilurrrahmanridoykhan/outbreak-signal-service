#!/bin/sh
# Rejects commit messages that carry assistant attribution or co-author trailers.
# Enable once per clone:  git config core.hooksPath .githooks
if grep -q -i -E 'co-authored-by|claude|anthropic' "$1"; then
  echo "commit-msg: message contains a co-author trailer or assistant attribution." >&2
  echo "commit-msg: this repository's commits are authored by the maintainer only." >&2
  exit 1
fi
